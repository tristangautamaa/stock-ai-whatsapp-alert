# Normalize all text files to LF in the repo; checkout as-is on Windows
* text=auto eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Binaries — no line-ending conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
