# ─── App ─────────────────────────────────────────────
APP_ENV=dev
DRY_RUN=true
LOG_LEVEL=INFO

# ─── Market Data ─────────────────────────────────────
# Choices: yfinance | sectors | twelvedata | finnhub
MARKET_DATA_PROVIDER=yfinance

# ─── Signal Thresholds ───────────────────────────────
SIGNAL_MIN_CONFIDENCE=60
SIGNAL_ALERT_THRESHOLD=65

# ─── WhatsApp Provider ───────────────────────────────
# Choices: meta | twilio | pywhatkit
WHATSAPP_PROVIDER=meta

# pywhatkit (requires WhatsApp Web open & logged in)
WHATSAPP_RECIPIENT=+62812xxxxxxx

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_API_VERSION=v20.0

# Twilio WhatsApp Sandbox (fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# ─── TradingView ─────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=

# ─── External Data APIs ──────────────────────────────
SECTORS_API_KEY=
TIMEGPT_API_KEY=

# ─── LLM APIs ────────────────────────────────────────
OPENAI_API_KEY=

# Used by src/ai/macro_narrative.py for AI morning brief via Claude
# (claude-sonnet-4-20250514 with web_search). Falls back to rule-based
# summary when key is absent.
ANTHROPIC_API_KEY=
